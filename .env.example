# Auth (pick one; see README "Authentication")
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_personal_access_token
# DATABRICKS_CLIENT_ID=...          # OAuth service principal instead of a token
# DATABRICKS_CLIENT_SECRET=...
# DATABRICKS_CONFIG_PROFILE=DEFAULT # or use a ~/.databrickscfg profile

# Optional
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_MCP_READ_ONLY=false
# DATABRICKS_MCP_TOOLSETS=unity_catalog,sql,volumes
# DATABRICKS_MCP_MAX_RESPONSE_CHARS=50000
# DATABRICKS_MCP_LOG_LEVEL=WARNING

# MCP clients pass env vars in their own config. This file is only read if you
# export it yourself, e.g.: set -a; source .env; set +a
